rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function login()  { return request.auth != null; }
    function admin()  { return login() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function pemilik(uid) { return login() && request.auth.uid == uid; }

    // Katalog buku: semua orang boleh membaca. Menulis lewat API server (bukan browser).
    match /books/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Profil & saldo: pemilik boleh MEMBACA saja. Saldo TIDAK boleh diubah dari browser.
    match /users/{uid} {
      allow read: if pemilik(uid) || admin();
      allow write: if false;
    }

    // Permintaan top up: pemilik & admin boleh membaca. Dibuat/diubah hanya oleh server.
    match /topups/{id} {
      allow read: if admin() || (login() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Riwayat mutasi saldo (ledger): baca oleh pemilik/admin, tulis hanya server.
    match /ledger/{id} {
      allow read: if admin() || (login() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Daftar admin: hanya bisa dibuat manual lewat Firebase Console.
    match /admins/{uid} {
      allow read: if pemilik(uid);
      allow write: if false;
    }

    // Selain yang tercantum di atas: tertutup total.
    match /{document=**} { allow read, write: if false; }
  }
}
