# ===== Firebase (Project settings > General > Your apps > Web app) =====
FIREBASE_API_KEY=isi_web_api_key
FIREBASE_AUTH_DOMAIN=proyekmu.firebaseapp.com
FIREBASE_PROJECT_ID=proyekmu
FIREBASE_APP_ID=1:1234567890:web:abcdef

# ===== Service Account (Project settings > Service accounts > Generate new private key) =====
# JANGAN pernah taruh ini di kode atau di GitHub. Isi hanya di Vercel > Settings > Environment Variables.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@proyekmu.iam.gserviceaccount.com
# Salin private_key dari file JSON apa adanya; ganti baris baru dengan \n bila perlu
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI\n-----END PRIVATE KEY-----\n"

# ===== Tujuan transfer top up (ditampilkan ke pembeli) =====
PEMBAYARAN_METODE=DANA
PEMBAYARAN_NAMA=Nama Pemilik
PEMBAYARAN_NOMOR=08xxxxxxxxxx

# ===== Supabase Storage (untuk gambar sampul & file buku) =====
# Ambil di: supabase.com -> proyekmu -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# JANGAN pernah taruh service_role di kode atau di GitHub. Isi hanya di Vercel > Settings > Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key
